{
  "name": "@p9s/kysely",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Vincent Lecrubier",
  "homepage": "https://p9s.vercel.app",
  "bugs": "https://github.com/crubier/p9s/issues",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crubier/p9s.git",
    "directory": "packages/kysely"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "*.ts",
    "!*.test.ts"
  ],
  "description": "Runs Kysely transactions as a user of p9s",
  "keywords": [
    "postgres",
    "rls",
    "permissions",
    "kysely"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@p9s/core": "workspace:*",
    "@p9s/postgres": "workspace:*"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "kysely": "^0.29.6",
    "kysely-pglite-dialect": "^1.3.1",
    "@electric-sql/pglite": "^0.3.14"
  }
}
