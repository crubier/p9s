diff --git a/pyproject.toml b/pyproject.toml
index b03a302..a60b236 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -6,5 +6,9 @@ requires-python = ">=3.12"
 dependencies = [
   "django>=6.0",
   "gunicorn>=23",
+  "p9s[django]>=0.1",
   "psycopg[binary]>=3.2",
 ]
+
+[tool.uv.sources]
+p9s = { path = "../../../../packages/python", editable = true }
diff --git a/site_config/settings.py b/site_config/settings.py
index e22343a..ae3772f 100644
--- a/site_config/settings.py
+++ b/site_config/settings.py
@@ -11,7 +11,10 @@ ALLOWED_HOSTS = ["127.0.0.1", "localhost"]
 INSTALLED_APPS = ["documents"]
 
 # A real app signs users in with django.contrib.auth, this one reads the user from a header
-MIDDLEWARE = ["documents.middleware.UserFromHeader"]
+MIDDLEWARE = ["documents.middleware.UserFromHeader", "p9s.django.P9sMiddleware"]
+# p9s runs every request in a transaction as its user, after the middleware that signs users in
+P9S_CONFIG = BASE_DIR / "p9s.config.json"
+P9S_USER_ID = "documents.middleware.user_id_of"
 
 ROOT_URLCONF = "site_config.urls"
 WSGI_APPLICATION = "site_config.wsgi.application"
