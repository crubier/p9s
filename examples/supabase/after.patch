diff --git b/supabase/migrations/20260201000000_api_grants.sql b/supabase/migrations/20260201000000_api_grants.sql
new file mode 100644
index 0000000..05787f6
--- /dev/null
+++ b/supabase/migrations/20260201000000_api_grants.sql
@@ -0,0 +1,7 @@
+-- Supabase grants every role of its API every privilege on the tables of public. p9s grants authenticated what its
+-- config names, and these take back the rest, so that a signed in user cannot join a team or share a project through
+-- the API, and anon reads nothing.
+revoke all on all tables in schema public from anon, authenticated;
+revoke all on all sequences in schema public from anon, authenticated;
+alter default privileges in schema public revoke all on tables from anon, authenticated;
+alter default privileges in schema public revoke all on sequences from anon, authenticated;
