@@ -1,12 +1,23 @@
 import { createClient, PostgrestError } from "@supabase/supabase-js";
+import { sign } from "hono/jwt";
 import type { Database } from "./database.types.ts";
 
 export type { Access } from "./database.types.ts";
 
 const options = { auth: { persistSession: false, autoRefreshToken: false } };
 
-// The server reads and writes every table with the service role key, which RLS lets through
-export const supabase = createClient<Database>(process.env.SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!, options);
+// A client of the user, whose requests PostgREST runs as authenticated with the claims of their JWT, which p9s reads
+// the user from. A real app passes on the access token of the session. This one signs a token for the user of the
+// request, whose subject is their id in the users table, as a custom JWT or third party auth does.
+export const clientOf = async (userId: number) => {
+  const token = await sign({ sub: String(userId), role: "authenticated", exp: Math.floor(Date.now() / 1000) + 60 }, process.env.SUPABASE_JWT_SECRET!);
+  return createClient<Database>(process.env.SUPABASE_URL!, process.env.SUPABASE_ANON_KEY!, {
+    ...options,
+    global: { headers: { Authorization: `Bearer ${token}` } },
+  });
+};
+
+export type Client = Awaited<ReturnType<typeof clientOf>>;
 
 type Result<T> = PromiseLike<{ data: T, error: PostgrestError | null }>;
 
