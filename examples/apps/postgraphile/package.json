{
  "name": "@p9s/example-postgraphile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun run --cwd ../../.. build && vite build",
    "start": "NODE_ENV=production bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "db:p9s": "bun src/p9s.ts",
    "db:migrate": "bun src/migrate.ts",
    "db:seed": "bun src/seed.ts",
    "schema": "bun src/print-schema.ts && bun run codegen",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@p9s/postgres": "workspace:*",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.4.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pg-sql2": "^4.14.1",
    "postgraphile": "^5.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.4",
    "@graphql-codegen/client-preset": "^6.2.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/node": "^21.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
